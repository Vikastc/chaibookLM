# Local development only. The app defaults to this URL when not in production.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Set only in the Vercel web project. This is used server-side to proxy /api
# requests to the separate Express deployment and is never exposed to users.
# API_ORIGIN=https://your-api-project.vercel.app

# Web3Forms - feedback modal (get key at https://app.web3forms.com/)
NEXT_PUBLIC_WEB3FORMS_KEY=
