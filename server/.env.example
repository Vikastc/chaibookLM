# ─── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8080
CLIENT_URL=http://localhost:3001

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=chaibook

# ─── PDF Storage (required by src/lib/cloudinary.ts) ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Optional integrations ────────────────────────────────────────────────────
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
MEM0_API_KEY=

# ─── Inngest (job queue) ──────────────────────────────────────────────────────
# Set INNGEST_DEV=1 for local dev only (disables event signing).
# In production, remove INNGEST_DEV and set the three keys below instead.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_SERVE_ORIGIN=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
